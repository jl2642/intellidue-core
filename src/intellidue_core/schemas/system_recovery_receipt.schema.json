{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intellidue.dev/v1/system_recovery_receipt.schema.json",
  "title": "SystemRecoveryReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_package", "expected_sha256", "actual_sha256", "authority_status", "required_contracts_verified", "gate"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "system_package": {"type": "string", "minLength": 1},
    "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actual_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_status": {"enum": ["CURRENT", "RECOVERY_PARENT", "WITHDRAWN", "UNKNOWN"]},
    "required_contracts_verified": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "gate": {"enum": ["RECOVERY_PASS", "RECOVERY_FAIL"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
